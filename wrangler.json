{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hi-open-world-crm-api",
  "compatibility_date": "2026-01-14",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/app/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "crm", "database_id": "0" }
  ]
}
